# Environment variables for Bookshelf backend
# Copy this to .env and fill in values

PORT=3000

# JWT
JWT_SECRET=change-this-to-a-random-64-char-string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=bookshelf
DB_PASSWORD=bookshelf
DB_NAME=bookshelf

# Redis (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible storage (AWS S3, MinIO, Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bookshelf-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# OpenAI (GPT-4o Vision for book recognition)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Apple App Store (for IAP receipt validation)
APP_STORE_SHARED_SECRET=
APP_STORE_ENV=sandbox
